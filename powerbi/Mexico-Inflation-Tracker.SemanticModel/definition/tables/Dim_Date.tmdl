table Dim_Date
    lineageTag: 9cddc870-60cb-4bd7-b09b-315c85a8a0e2

    column Date
        dataType: dateTime
        formatString: Short Date
        isKey
        summarizeBy: none
        sourceColumn: Date
        lineageTag: 5f27a5a3-2c13-4e73-a72b-4d8c3e0b7c11

    column Year
        dataType: int64
        formatString: 0
        summarizeBy: none
        sourceColumn: Year
        lineageTag: 5f27a5a3-2c13-4e73-a72b-4d8c3e0b7c12

    column MonthNumber
        dataType: int64
        formatString: 0
        summarizeBy: none
        sourceColumn: MonthNumber
        lineageTag: 5f27a5a3-2c13-4e73-a72b-4d8c3e0b7c13

    column MonthName
        dataType: string
        summarizeBy: none
        sourceColumn: MonthName
        lineageTag: 5f27a5a3-2c13-4e73-a72b-4d8c3e0b7c14

    column YearMonth
        dataType: string
        summarizeBy: none
        sourceColumn: YearMonth
        lineageTag: 5f27a5a3-2c13-4e73-a72b-4d8c3e0b7c15

    partition Dim_Date = calculated
        mode: import
        source =
            ADDCOLUMNS(
                CALENDAR(MIN(Fact_INPC[Fecha]), MAX(Fact_INPC[Fecha])),
                "Year", YEAR([Date]),
                "MonthNumber", MONTH([Date]),
                "MonthName", FORMAT([Date], "MMMM", "es-MX"),
                "YearMonth", FORMAT([Date], "YYYY-MM")
            )
